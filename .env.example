# ══════════════════════════════════════════════════════════
#  GHOST NEWERA — Environment Variables (Production)
#  Copy file ini ke .env dan isi semua nilainya
# ══════════════════════════════════════════════════════════

# ─── SERVER ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production
VERCEL=1

# ─── SESSION (WAJIB — generate random string panjang) ────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=GANTI_STRING_RANDOM_64_KARAKTER_DI_SINI

# ─── SUPABASE DATABASE (WAJIB) ───────────────────────────
# Dapat dari: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# PENTING: pakai SERVICE_ROLE key (bukan anon key).
# Server butuh full read/write ke keyvalue_store, dan RLS sekarang
# memblokir akses anon sepenuhnya. Service role key BYPASS RLS —
# JANGAN PERNAH expose key ini ke browser/client-side code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxx

# Optional — untuk auto-create tabel Supabase jika belum ada
SUPABASE_DB_PASSWORD=password_database_supabase_kamu

# ─── ADMIN AWAL (opsional, hanya dipakai saat pertama kali initDB jalan) ──
# Kalau tidak diisi, password admin akan di-generate random dan
# di-print SEKALI ke log server saat start — cek log lalu ganti
# lewat Admin Panel setelah login pertama.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=

# ─── SETUP ENDPOINT (opsional — /ghostnewera-setup) ──────────
# WAJIB diisi ketiga-tiganya kalau mau pakai endpoint /ghostnewera-setup
# untuk reset kredensial admin & re-push settings default lewat browser.
# Endpoint ini akan MENOLAK jalan kalau INITIAL_ADMIN_USERNAME atau
# INITIAL_ADMIN_PASSWORD kosong — supaya kredensial admin tidak pernah
# fallback ke nilai tertulis di source code.
# SETELAH DIPAKAI: hapus SETUP_SECRET dari env Vercel.
# SETUP_SECRET=GANTI_STRING_RANDOM_DI_SINI
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=GantiPasswordKuat123!

# ─── Hanya untuk menjalankan seed-settings.js secara lokal ───
# JANGAN diisi di env Vercel — ini cuma dipakai sekali dari lokal.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=

# ─── CLOUDFLARE TURNSTILE (opsional — anti-bot login) ────
# Daftar gratis di: https://dash.cloudflare.com → Turnstile
# Aktif otomatis saat kedua key ini diisi. Kosongkan = Turnstile dimatikan.
# TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# ─── METODE PEMBAYARAN ────────────────────────────────────
# Ada 3 metode pembayaran yang bisa dipilih di Admin Panel → Settings →
# Pengaturan QRIS. HANYA SATU yang bisa aktif dalam satu waktu:
#   1. Statis (gambar QRIS, konfirmasi manual admin)
#   2. Pakasir API (app.pakasir.com)
#   3. GensPay API (genspay.my.id)
# Kredensial di bawah ini opsional lewat env var — bisa juga diisi langsung
# dari Admin Panel (lebih praktis), tapi env var lebih aman untuk production.

# ─── PAKASIR QRIS (isi setelah daftar di pakasir.com) ────
# Setting ini JUGA bisa diisi dari Admin Panel → Settings → Pakasir
# PAKASIR_API_KEY=your_api_key_here
# PAKASIR_PROJECT=your_project_name_here

# ─── GENSPAY QRIS (isi setelah daftar di genspay.my.id) ────
# 📖 Dokumentasi Integrasi: Buka Swagger API https://genspay.my.id/docs
# Base URL API: https://genspay.my.id/api/v1
# Cara pakai:
#   1. Buat project di Settings → dapat API Key
#   2. Kirim API Key di header X-API-Key
#   3. Gunakan endpoint create/status/cancel
# Ada kendala? Hubungi admin.
# Setting ini JUGA bisa diisi dari Admin Panel → Settings → GensPay
# Tapi lebih aman disimpan di env var
# GENSPAY_API_KEY=your_api_key_here
# GENSPAY_BASE_URL=https://genspay.my.id/api/v1

# ─── RESELLER API — AUTO STOCK PRODUK (mis. vipibmstore.com) ────
# Dipakai untuk produk dengan Mode Stok = "Auto" di halaman Edit Produk:
# key di-generate otomatis lewat API provider saat ada pembelian, tidak
# perlu upload key manual. Autentikasi pakai HMAC-SHA256 (lihat reseller-api.js).
# Setting ini JUGA bisa diisi dari Admin Panel → Settings → Reseller API
# (Auto Stock Produk) — tapi env var lebih aman untuk production.
# ⚠️ JANGAN commit nilai asli ke git / kirim lewat chat. Kalau pernah
# bocor, WAJIB regenerate dulu dari dashboard provider sebelum dipakai.
# RESELLER_API_KEY=rpk_live_xxxxxxxxxxxxxxxxxxxxx
# RESELLER_API_SECRET=rsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESELLER_API_BASE_URL=https://vipibmstore.com/api/reseller

# GhostSeller Partner API — Auto Restock (lihat ghostseller-api.js).
# Setting ini JUGA bisa diisi dari Admin Panel → Settings → GhostSeller
# Partner API. API Key didapat dari proyek GhostSeller di
# /dashboard/admin/settings/partner-api (harus login sebagai admin
# GhostSeller). ⚠️ Sama seperti Reseller API di atas: jangan commit /
# kirim lewat chat, regenerate kalau bocor.
# GHOSTSELLER_API_KEY=gs_partner_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GHOSTSELLER_BASE_URL=https://ghostseller.my.id/api/v1/partner

# ──────────────────────────────────────────────────────────
#  CATATAN PENTING:
#  - JANGAN set ADMIN_USERNAME / ADMIN_PASSWORD hardcoded di kode manapun
#  - Setelah set env di Vercel, jalankan seed-settings.js dari lokal
#    (dengan SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD di .env lokal)
#    untuk push credentials ke Supabase
# ──────────────────────────────────────────────────────────
