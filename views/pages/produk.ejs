<%
const pageTitle = 'Daftar Harga';
const __opts = (product) => {
  const items = Array.isArray(product.items) ? product.items : [];
  if (items.length) return items.map(i => ({ l: i.l || i.label || '', p: Number(i.p ?? i.price) || 0 }));
  const po = Array.isArray(product.pricingOptions) ? product.pricingOptions : [];
  return po.map(o => ({ l: (o.days ? o.days + ' ' + (o.unit === 'hours' ? 'Jam' : 'Hari') : (o.label || '')), p: Number(o.price) || 0 }));
};
%>
<%- include('../partials/edot-header') %>

<div class="edot-wrap" style="padding-top:14px;">
  <h1 style="font-size:18px;font-weight:900;color:#0f172a;margin:0;">Daftar Harga</h1>
  <p style="font-size:12px;color:#64748b;margin:3px 0 0;font-weight:600;">Harga semua produk. Klik produk untuk membeli.</p>

  <div style="display:flex;gap:8px;overflow-x:auto;padding:14px 0 6px;scrollbar-width:none;">
    <a href="/produk?category=all" class="edot-chip <%= activeCategory==='all' ? 'active' : '' %>" style="text-decoration:none;">Semua</a>
    <% (categories || []).forEach(cat => { %>
    <a href="/produk?category=<%= cat %>" class="edot-chip <%= activeCategory===cat ? 'active' : '' %>" style="text-decoration:none;"><%= categoryLabels[cat] || cat %></a>
    <% }); %>
  </div>
  <div style="font-size:11px;color:#94a3b8;font-weight:700;margin:4px 0 10px;">Menampilkan <%= products.length %> dari <%= totalProducts %> produk</div>

  <div style="display:flex;flex-direction:column;gap:10px;" class="edot-pad-b">
    <% products.forEach(product => {
      const opts = __opts(product);
      const hasGs = Array.isArray(product.pricingOptions) && product.pricingOptions.some(o => o.stockSource === 'ghostseller' || o.stockSource === 'vipbestmods');
      const unlimited = product.stockMode === 'ghostseller' || product.stockMode === 'vipbestmods' || product.stockMode === 'mixed' || hasGs;
      const isOut = !unlimited && (product.keyCount || 0) === 0;
      const offline = (product.operationalStatus || 'online') === 'offline';
      const bad = isOut || offline;
    %>
    <div class="edot-box" style="overflow:hidden;">
      <a href="/buy/<%= product.id %>" style="display:flex;align-items:center;gap:11px;padding:11px 12px;text-decoration:none;border-bottom:1px solid var(--border);background:#fafbfe;">
        <div style="width:44px;height:44px;border-radius:11px;overflow:hidden;background:#eef2fa;flex-shrink:0;">
          <% if (product.image) { %><img src="<%= product.image %>" alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy"><% } %>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:800;color:#0f172a;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= product.name %></div>
          <div style="font-size:10.5px;font-weight:700;margin-top:2px;color:<%= bad ? '#dc2626' : '#16a34a' %>;"><%= offline ? 'Offline' : (isOut ? 'Stok habis' : 'Tersedia - proses instan') %></div>
        </div>
        <iconify-icon icon="mdi:chevron-right" style="font-size:20px;color:#94a3b8;"></iconify-icon>
      </a>
      <% if (opts.length) { %>
      <table style="width:100%;border-collapse:collapse;">
        <% opts.forEach((o, i) => { %>
        <tr style="<%= i < opts.length-1 ? 'border-bottom:1px solid #eef1f7;' : '' %>">
          <td style="padding:9px 12px;font-size:12px;font-weight:600;color:#475569;"><%= o.l %></td>
          <td style="padding:9px 12px;font-size:12.5px;font-weight:900;color:#2563eb;text-align:right;white-space:nowrap;">Rp <%= o.p.toLocaleString('id-ID') %></td>
        </tr>
        <% }); %>
      </table>
      <% } else { %>
      <div style="padding:10px 12px;font-size:12px;color:#94a3b8;">Belum ada varian harga</div>
      <% } %>
    </div>
    <% }); %>

    <% if (products.length === 0) { %>
    <div style="text-align:center;padding:50px 0;color:#94a3b8;font-size:12px;font-weight:600;">Belum ada produk di kategori ini</div>
    <% } %>

    <% if (totalPages > 1) {
      const sP = Math.max(1, page-2), eP = Math.min(totalPages, page+2); %>
    <div style="display:flex;justify-content:center;gap:6px;margin-top:8px;flex-wrap:wrap;">
      <a class="edot-chip" style="text-decoration:none;<%= page<=1 ? 'opacity:.4;pointer-events:none;' : '' %>" href="/produk?category=<%= activeCategory %>&page=<%= Math.max(1,page-1) %>">&lsaquo;</a>
      <% for (let p=sP;p<=eP;p++) { %><a class="edot-chip <%= p===page?'active':'' %>" style="text-decoration:none;" href="/produk?category=<%= activeCategory %>&page=<%= p %>"><%= p %></a><% } %>
      <a class="edot-chip" style="text-decoration:none;<%= page>=totalPages ? 'opacity:.4;pointer-events:none;' : '' %>" href="/produk?category=<%= activeCategory %>&page=<%= Math.min(totalPages,page+1) %>">&rsaquo;</a>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/edot-footer') %>
<%- include('../partials/edot-bottom') %>
