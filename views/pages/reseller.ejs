<!DOCTYPE html>
<html lang="id" class="edot">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<title>Reseller VIP — <%= settings.siteName %></title>
<% if (typeof twCss !== 'undefined' && twCss) { %><style><%- twCss %></style><% } else { %><link rel="stylesheet" href="/tw.css"><% } %>
<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html{height:100%;width:100%;max-width:100%;overflow-x:hidden;background:#f3f5fa;}
:root{
    --bg-main:#f3f5fa;--bg-card:#fff;--bg-hover:#f1f5fb;--border:#e6eaf3;--border-md:#d5dcea;--blue:#2563eb;--blue-dim:rgba(37,99,235,.10);--green:#16a34a;--text-1:#0f172a;--text-2:#475569;--text-3:#94a3b8;
}
body{font-family:'Inter',sans-serif;background:var(--bg-main);color:var(--text-1);min-height:100dvh;width:100%;max-width:100%;overflow-x:hidden;position:relative;padding-bottom:40px;-webkit-font-smoothing:antialiased;}
@keyframes fadeInUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes slideInBottom{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}
.fade-in-up{animation:fadeInUp .3s ease-out both;}
.animate-spin{animation:spin 1s linear infinite;}
.card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;}
.hm-input{width:100%;padding:10px 14px;border-radius:8px;background:#fff;border:1px solid var(--border-md);color:var(--text-1);font-size:13px;transition:border-color .15s;font-family:'Inter',sans-serif;}
.hm-input:focus{outline:none;border-color:#2563eb;background:#fff;}
.benefit-row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);}
.benefit-row:last-child{border-bottom:none;}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--blue);color:#fff;font-weight:700;font-size:13px;border-radius:8px;cursor:pointer;border:none;transition:opacity .15s;}
.btn-primary:hover{opacity:.88;}
.btn-primary:active{opacity:.7;transform:scale(.97);}
#toast-wrap{position:fixed;top:14px;right:14px;z-index:9999;display:flex;flex-direction:column;gap:8px;}
.toast-item{padding:10px 14px;border-radius:10px;background:var(--bg-card);font-size:12px;max-width:280px;border:1px solid var(--border-md);color:var(--text-1);}
.toast-success{border-color:rgba(34,197,94,.45);color:#15803d;}
.toast-error{border-color:rgba(239,68,68,.45);color:#b91c1c;}
</style>
<%- include('../partials/edot-theme') %>
</head>
<body>
<div id="toast-wrap"></div>

<!-- NAVBAR -->
<header class="edot-header"><div class="edot-header-in" style="max-width:640px;">
    <%- include('../partials/edot-brand') %>
    <a href="/" class="edot-hbtn" style="margin-left:auto;width:auto;padding:0 12px;gap:6px;font-size:12px;font-weight:700;text-decoration:none;"><iconify-icon icon="mdi:arrow-left" style="font-size:15px;"></iconify-icon> Kembali</a>
</div></header>

<div style="min-height:100dvh;padding-top:16px;padding-bottom:40px;padding-left:16px;padding-right:16px;">
<div style="max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:12px;">

<!-- ── HERO ── -->
<div class="card fade-in-up" style="margin-top:16px;border-color:rgba(124,47,214,.25);">
    <div style="height:3px;background:var(--blue);border-radius:12px 12px 0 0;"></div>
    <div style="padding:24px;text-align:center;">
        <div style="width:56px;height:56px;border-radius:14px;background:var(--blue-dim);border:1px solid rgba(124,47,214,.3);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <iconify-icon icon="mdi:crown" style="color:var(--blue);font-size:26px;"></iconify-icon>
        </div>
        <div style="font-size:16px;font-weight:800;color:var(--text-1);letter-spacing:.02em;margin-bottom:8px;">RESELLER VIP</div>
        <p style="font-size:13px;color:var(--text-2);line-height:1.6;max-width:320px;margin:0 auto;">
            <%= settings.resellerNote || 'Bergabung dan nikmati harga eksklusif untuk semua produk.' %>
        </p>
    </div>
</div>

<% if (user && user.is_reseller) { %>
<!-- ── SUDAH RESELLER ── -->
<div class="card fade-in-up" style="padding:24px;text-align:center;border-color:rgba(34,197,94,.2);">
    <iconify-icon icon="mdi:check-decagram" style="font-size:36px;color:#4ade80;display:block;margin:0 auto 12px;"></iconify-icon>
    <div style="font-size:15px;font-weight:800;color:#4ade80;margin-bottom:6px;">Kamu sudah Reseller VIP!</div>
    <p style="font-size:12px;color:var(--text-3);margin-bottom:16px;">Diskon <strong style="color:var(--blue);"><%= settings.resellerDiscount || 20 %>%</strong> aktif otomatis di semua pembelian.</p>
    <% if (user.reseller_code) { %>
    <div style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:8px;background:var(--blue-dim);border:1px solid rgba(124,47,214,.3);font-family:monospace;font-size:14px;font-weight:800;color:var(--blue);margin-bottom:6px;">
        <iconify-icon icon="mdi:identifier" style="font-size:16px;"></iconify-icon>
        <%= user.reseller_code %>
    </div>
    <p style="font-size:10px;color:var(--text-3);">Kode identitas reseller kamu</p>
    <% } %>
    <a href="/" class="btn-primary" style="margin-top:20px;padding:10px 24px;font-size:13px;text-decoration:none;">
        <iconify-icon icon="mdi:shopping" style="font-size:15px;"></iconify-icon> Belanja Sekarang
    </a>
</div>

<% } else { %>
<!-- ── BENEFIT LIST ── -->
<div class="card fade-in-up" style="padding:20px;">
    <div style="font-size:12px;font-weight:700;color:var(--text-2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px;">Keuntungan Bergabung</div>

    <div class="benefit-row">
        <div style="width:36px;height:36px;border-radius:9px;background:var(--blue-dim);border:1px solid rgba(124,47,214,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <iconify-icon icon="mdi:tag-multiple" style="color:var(--blue);font-size:16px;"></iconify-icon>
        </div>
        <div>
            <div style="font-size:13px;font-weight:700;color:var(--text-1);">Diskon <span style="color:var(--blue);"><%= settings.resellerDiscount || 20 %>%</span> Otomatis Semua Produk</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:3px;">Harga reseller langsung terpotong tanpa perlu input kode apapun.</div>
        </div>
    </div>

    <div class="benefit-row">
        <div style="width:36px;height:36px;border-radius:9px;background:var(--blue-dim);border:1px solid rgba(124,47,214,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <iconify-icon icon="mdi:lightning-bolt" style="color:var(--blue);font-size:16px;"></iconify-icon>
        </div>
        <div>
            <div style="font-size:13px;font-weight:700;color:var(--text-1);">Harga Langsung Terpotong di Checkout</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:3px;">Harga normal dicoret, harga reseller tampil di setiap pilihan paket.</div>
        </div>
    </div>

    <div class="benefit-row">
        <div style="width:36px;height:36px;border-radius:9px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <iconify-icon icon="mdi:identifier" style="color:#4ade80;font-size:16px;"></iconify-icon>
        </div>
        <div>
            <div style="font-size:13px;font-weight:700;color:var(--text-1);">Kode Reseller Unik</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:3px;">Kode identitas reseller sebagai tanda keanggotaan VIP.</div>
        </div>
    </div>

    <div class="benefit-row">
        <div style="width:36px;height:36px;border-radius:9px;background:var(--blue-dim);border:1px solid rgba(124,47,214,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <iconify-icon icon="mdi:crown" style="color:var(--blue);font-size:16px;"></iconify-icon>
        </div>
        <div>
            <div style="font-size:13px;font-weight:700;color:var(--text-1);">Badge VIP di Profil & Leaderboard</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:3px;">Status VIP tampil di badge profil dan halaman admin.</div>
        </div>
    </div>
</div>

<!-- ── HARGA & BAYAR ── -->
<div class="card fade-in-up" style="padding:24px;">
    <div style="text-align:center;margin-bottom:20px;">
        <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;">Biaya Keanggotaan Reseller VIP</div>
        <div style="font-size:36px;font-weight:900;color:var(--text-1);line-height:1;margin-bottom:6px;">
            Rp <%= (settings.resellerPrice || 50000).toLocaleString('id-ID') %>
        </div>
        <div style="font-size:11px;color:var(--text-3);">Bayar sekali · Diskon <strong style="color:var(--blue);"><%= settings.resellerDiscount || 20 %>%</strong> berlaku selamanya</div>
    </div>

    <% if (!user) { %>
    <a href="/login?redirect=/reseller" class="btn-primary" style="width:100%;padding:13px;font-size:14px;border-radius:10px;text-decoration:none;">
        <iconify-icon icon="mdi:login" style="font-size:16px;"></iconify-icon> Login untuk Bergabung
    </a>
    <p style="font-size:11px;color:var(--text-3);text-align:center;margin-top:10px;">Belum punya akun? <a href="/register" style="color:var(--blue);text-decoration:none;">Daftar gratis</a></p>
    <% } else { %>
    <%
      const waNumber = (settings.contact?.whatsapp || '').replace(/\D/g, '');
    %>
    <div id="rsPayStep1">
        <button id="rsPayBtn" onclick="rsStartPay()" class="btn-primary" style="width:100%;padding:13px;font-size:14px;border-radius:10px;">
            <iconify-icon icon="mdi:qrcode-scan" style="font-size:18px;"></iconify-icon> Bayar Sekarang
        </button>
        <p style="font-size:11px;color:var(--text-3);text-align:center;margin-top:10px;">QRIS · otomatis aktif setelah bayar, tanpa konfirmasi admin.</p>
    </div>

    <div id="rsPayStep2" style="display:none;text-align:center;">
        <div style="font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--text-3);text-transform:uppercase;margin-bottom:6px;">Batas waktu pembayaran</div>
        <div id="rsTimer" style="font-size:30px;font-weight:900;color:#d97706;font-variant-numeric:tabular-nums;margin-bottom:14px;">15:00</div>
        <div id="rsQrWrap" style="margin-bottom:12px;"></div>
        <div style="font-size:11px;color:var(--text-3);margin-bottom:4px;">Kode order: <strong id="rsCode" style="color:var(--text-1);font-family:monospace;">-</strong></div>
        <div style="font-size:20px;font-weight:900;color:var(--text-1);margin-bottom:10px;" id="rsAmount"></div>
        <div id="rsStatus" style="display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;color:var(--text-2);margin-bottom:12px;">
            <span style="width:8px;height:8px;border-radius:50%;background:#f59e0b;display:inline-block;"></span> Menunggu pembayaran...
        </div>
        <div id="rsStaticNote" style="display:none;font-size:11px;color:var(--text-2);margin-bottom:10px;">QRIS ini dikonfirmasi manual oleh admin. Setelah bayar, kirim bukti lewat WhatsApp.</div>
        <a id="rsWaBtn" href="#" target="_blank" rel="noopener" style="display:none;margin-bottom:10px;padding:11px;border-radius:10px;background:#16a34a;color:#fff;font-weight:700;font-size:13px;text-decoration:none;">Konfirmasi via WhatsApp</a>
        <button onclick="rsCheckNow()" style="width:100%;padding:11px;border-radius:10px;border:1px solid var(--border-md);background:#fff;color:var(--text-1);font-weight:700;font-size:12px;cursor:pointer;">Saya sudah bayar, cek status</button>
    </div>
    <% } %>
</div>

<% } %>
</div>
</div>


<script>
var RS_WA = '<%= (settings.contact?.whatsapp || "").replace(/\D/g, "") %>';
var RS_PRICE = <%= settings.resellerPrice || 50000 %>;
var rsRef = null, rsStopped = false, rsTick = null, rsTimerI = null, rsBusy = false;
function rsStartPay(){
    var btn = document.getElementById('rsPayBtn');
    if (btn.disabled) return;
    btn.disabled = true; btn.style.opacity = '.6';
    btn.innerHTML = '<iconify-icon icon="mdi:loading" class="animate-spin" style="font-size:18px;"></iconify-icon> Memproses...';
    fetch('/reseller/join', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (!d.success) { showToast(d.message || 'Gagal membuat pembayaran', 'error'); rsResetBtn(); return; }
        rsShowQr(d);
      })
      .catch(function(){ showToast('Koneksi bermasalah, coba lagi.', 'error'); rsResetBtn(); });
}
function rsResetBtn(){
    var btn = document.getElementById('rsPayBtn');
    btn.disabled = false; btn.style.opacity = '';
    btn.innerHTML = '<iconify-icon icon="mdi:qrcode-scan" style="font-size:18px;"></iconify-icon> Bayar Sekarang';
}
function rsShowQr(d){
    rsRef = d.refId; rsStopped = false;
    document.getElementById('rsPayStep1').style.display = 'none';
    document.getElementById('rsPayStep2').style.display = 'block';
    document.getElementById('rsCode').textContent = d.orderCode || '-';
    document.getElementById('rsAmount').textContent = 'Rp ' + RS_PRICE.toLocaleString('id-ID');
    var wrap = document.getElementById('rsQrWrap');
    if (d.isStatic && d.qrisStaticImage) {
        wrap.innerHTML = '<div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;border:1px solid var(--border);"><img src="'+d.qrisStaticImage+'" style="display:block;width:210px;height:210px;object-fit:contain;"></div>';
        document.getElementById('rsStaticNote').style.display = 'block';
        var wa = document.getElementById('rsWaBtn');
        wa.href = 'https://wa.me/' + RS_WA + '?text=' + encodeURIComponent('Konfirmasi upgrade Reseller VIP, kode: ' + (d.orderCode||'-') + ', nominal: Rp ' + RS_PRICE.toLocaleString('id-ID'));
        wa.style.display = 'block';
    } else if (d.qrString) {
        wrap.innerHTML = '<div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;border:1px solid var(--border);"><img src="https://api.qrserver.com/v1/create-qr-code/?size=210x210&color=000000&bgcolor=ffffff&qzone=1&data='+encodeURIComponent(d.qrString)+'" style="display:block;width:210px;height:210px;"></div>';
    } else {
        wrap.innerHTML = '<p style="font-size:12px;color:var(--text-3);">QRIS belum dikonfigurasi. Hubungi admin.</p>';
    }
    // timer 15 menit (client-side)
    var end = Date.now() + 15*60*1000, el = document.getElementById('rsTimer');
    if (rsTimerI) clearInterval(rsTimerI);
    rsTimerI = setInterval(function(){
        var diff = end - Date.now();
        if (diff <= 0) { clearInterval(rsTimerI); el.textContent = '00:00'; el.style.color = '#dc2626'; rsStopped = true; rsSetStatus('Waktu pembayaran habis. Muat ulang halaman untuk bikin QRIS baru.', '#dc2626'); return; }
        var m = Math.floor(diff/60000), s = Math.floor((diff%60000)/1000);
        el.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
        el.style.color = diff < 120000 ? '#dc2626' : '#d97706';
    }, 1000);
    if (d.refId && !d.isStatic) {
        rsCheck();
        var t0 = Date.now();
        (function loop(){
            if (rsStopped) return;
            rsTick = setTimeout(async function(){
                if (!document.hidden) await rsCheck();
                loop();
            }, (Date.now() - t0) < 180000 ? 6000 : 15000);
        })();
        document.addEventListener('visibilitychange', function(){ if (!document.hidden && !rsStopped && rsRef) rsCheck(); });
    }
}
function rsSetStatus(text, color){
    document.getElementById('rsStatus').innerHTML = '<span style="width:8px;height:8px;border-radius:50%;background:'+color+';display:inline-block;"></span> ' + text;
}
function rsCheckNow(){ rsCheck(true); }
async function rsCheck(manual){
    if (!rsRef || rsBusy) return;
    rsBusy = true;
    try {
        var r = await fetch('/check-payment/' + rsRef);
        var d = await r.json();
        if (d.success && d.status === 'done') {
            rsStopped = true; clearTimeout(rsTick); clearInterval(rsTimerI);
            rsSetStatus('Pembayaran berhasil! Reseller VIP aktif.', '#16a34a');
            showToast('Selamat, kamu sekarang Reseller VIP!', 'success');
            setTimeout(function(){ location.reload(); }, 1500);
        } else if (d.status === 'expired') {
            rsStopped = true; clearTimeout(rsTick);
            rsSetStatus('Pembayaran expired. Muat ulang halaman untuk bikin QRIS baru.', '#dc2626');
        } else if (manual) {
            showToast('Pembayaran belum terdeteksi, tunggu sebentar lalu cek lagi.', 'info');
        }
    } catch(e) {} finally { rsBusy = false; }
}
function showToast(msg, type='info') {
    const wrap = document.getElementById('toast-wrap');
    const el = document.createElement('div');
    el.className = `toast-item toast-${type}`;
    el.textContent = msg;
    wrap.appendChild(el);
    setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3500);
}
</script>
</body>
</html>
