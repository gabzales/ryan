<%
const pageTitle = 'Beranda';
const siteName = settings?.siteName || 'RYAN NEW ERA';
%>
<%- include('../partials/edot-header') %>

<!-- ══ BANNER ══ -->
<div class="edot-wrap" style="padding-top:12px;">
  <div id="carousel-wrap" style="position:relative;overflow:hidden;border-radius:18px;height:clamp(150px,38vw,300px);background:#e8eefc;box-shadow:0 10px 30px -14px rgba(37,99,235,.45);user-select:none;">
    <div id="carousel-track" style="display:flex;height:100%;transition:transform .52s cubic-bezier(.4,0,.2,1);will-change:transform;">
      <div id="c-slide-default" style="flex:0 0 100%;position:relative;overflow:hidden;background:linear-gradient(120deg,#1d4ed8 0%,#2563eb 45%,#6366f1 100%);">
        <div style="position:absolute;right:-40px;top:-50px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.12);"></div>
        <div style="position:absolute;right:50px;bottom:-70px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.08);"></div>
        <div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,4vw,28px) clamp(18px,6vw,48px);max-width:640px;">
          <span style="display:inline-flex;align-items:center;gap:5px;align-self:flex-start;padding:4px 10px;border-radius:999px;font-size:9px;font-weight:900;background:rgba(255,255,255,.18);color:#fff;letter-spacing:.06em;margin-bottom:10px;">
            <span style="width:6px;height:6px;border-radius:50%;background:#4ade80;animation:blink 1.4s infinite;"></span> ONLINE 24 JAM
          </span>
          <div style="font-weight:900;color:#fff;line-height:1.05;font-size:clamp(22px,6vw,46px);letter-spacing:-.01em;"><%= siteName %></div>
          <div style="font-weight:700;color:rgba(255,255,255,.88);margin:8px 0 14px;font-size:clamp(12px,3vw,20px);">Beli key game instan, aman &amp; murah.</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a href="#games" style="display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-size:11px;font-weight:900;color:#1d4ed8;background:#fff;text-decoration:none;"><iconify-icon icon="mdi:cart" style="font-size:14px;"></iconify-icon> Beli Sekarang</a>
            <a href="/invoice" style="display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:12px;font-size:11px;font-weight:800;color:#fff;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);text-decoration:none;"><iconify-icon icon="mdi:receipt-text-check" style="font-size:14px;"></iconify-icon> Cek Order</a>
          </div>
        </div>
      </div>
    </div>
    <div id="carousel-dots" style="position:absolute;bottom:9px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;z-index:20;"><div class="c-dot active"></div></div>
  </div>
</div>

<!-- ══ INFO STRIP ══ -->
<div class="edot-wrap" style="margin-top:12px;">
  <div style="background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden;padding:8px 0;box-shadow:var(--shadow-card);">
    <div style="display:flex;gap:36px;white-space:nowrap;width:max-content;animation:marqueeAnim 28s linear infinite;">
      <% for (let r=0;r<2;r++){ %>
      <span style="font-size:11px;font-weight:700;color:#2563eb;"><iconify-icon icon="mdi:flash" style="vertical-align:-2px;"></iconify-icon> Proses instan, key langsung dikirim</span>
      <span style="font-size:11px;font-weight:700;color:#16a34a;"><iconify-icon icon="mdi:shield-check" style="vertical-align:-2px;"></iconify-icon> 100% aman &amp; bergaransi</span>
      <span style="font-size:11px;font-weight:700;color:#4f46e5;"><iconify-icon icon="mdi:qrcode-scan" style="vertical-align:-2px;"></iconify-icon> Pembayaran QRIS semua e-wallet &amp; bank</span>
      <span style="font-size:11px;font-weight:700;color:#d97706;"><iconify-icon icon="mdi:headset" style="vertical-align:-2px;"></iconify-icon> Sistem otomatis 24 jam</span>
      <% } %>
    </div>
  </div>
</div>

<!-- ══ MENU CEPAT ══ -->
<div class="edot-wrap">
  <div class="edot-sec-title"><h2>Menu Cepat</h2></div>
  <div class="edot-quick">
    <a href="#games"><i style="background:#eef3ff;color:#2563eb;"><iconify-icon icon="mdi:gamepad-variant"></iconify-icon></i>Beli Key</a>
    <a href="/produk"><i style="background:#ecfdf3;color:#16a34a;"><iconify-icon icon="mdi:tag-text"></iconify-icon></i>Daftar Harga</a>
    <a href="/invoice"><i style="background:#fff7e6;color:#d97706;"><iconify-icon icon="mdi:receipt-text-check"></iconify-icon></i>Cek Order</a>
    <% if (settings?.contact?.whatsapp) { %>
    <a href="https://wa.me/<%= String(settings.contact.whatsapp).replace(/\D/g,'') %>" target="_blank" rel="noopener"><i style="background:#ecfdf3;color:#16a34a;"><iconify-icon icon="mdi:whatsapp"></iconify-icon></i>Hubungi CS</a>
    <% } else { %>
    <a href="/register"><i style="background:#f1ecff;color:#6d28d9;"><iconify-icon icon="mdi:account-plus"></iconify-icon></i>Daftar</a>
    <% } %>
  </div>
</div>

<!-- ══ CARI + KATEGORI ══ -->
<div id="games" class="edot-wrap" style="padding-top:6px;scroll-margin-top:70px;">
  <div class="edot-sec-title"><h2>Cari Produk</h2></div>
  <div style="position:relative;">
    <iconify-icon icon="mdi:magnify" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);font-size:19px;color:#94a3b8;pointer-events:none;"></iconify-icon>
    <input class="edot-input" type="text" readonly placeholder="Cari game atau produk..." onclick="openSearch()" onfocus="openSearch()" style="cursor:pointer;">
  </div>
  <div style="display:flex;gap:8px;overflow-x:auto;padding:12px 0 4px;scrollbar-width:none;-ms-overflow-style:none;">
    <button type="button" onclick="filterProducts('all')" class="edot-chip fpill active" data-pf="all">Semua</button>
    <% (categories || []).forEach(cat => { %>
    <button type="button" onclick="filterProducts('<%= cat %>')" class="edot-chip fpill" data-pf="<%= cat %>"><%= categoryLabels[cat] || cat %></button>
    <% }); %>
  </div>
</div>

<!-- ══ GRID PRODUK (3 KOLOM, TANPA HARGA) ══ -->
<div class="edot-wrap">
  <div class="edot-sec-title"><h2>Semua Produk</h2><span id="shown-count"><%= products.length %> produk</span></div>

  <div id="product-grid" class="edot-grid">
    <% products.forEach((product, pIdx) => {
      const hasGs = Array.isArray(product.pricingOptions) && product.pricingOptions.some(o => o.stockSource === 'ghostseller' || o.stockSource === 'vipbestmods');
      const unlimited = product.stockMode === 'ghostseller' || product.stockMode === 'vipbestmods' || product.stockMode === 'mixed' || hasGs;
      const stock = unlimited ? Infinity : (product.keyCount || 0);
      const isOut = stock === 0;
      const opStatus = product.operationalStatus || 'online';
      const offline = opStatus === 'offline';
      const fakeSold = [3200,2800,1900,4100,2100,3700,1500,2400,3300,1700,2600,4500,1200,2900,3800][pIdx%15];
      const sold = (product.sold && product.sold>0) ? product.sold : fakeSold;
      const soldLabel = sold>=1000 ? (sold/1000).toFixed(1).replace('.0','')+'K' : String(sold);
      const bad = offline || isOut;
      const tagTxt = offline ? 'Offline' : (isOut ? 'Habis' : 'Instan');
    %>
    <a class="edot-pcard" href="/buy/<%= product.id %>" data-category="<%= product.category %>" style="<%= bad ? 'opacity:.72;' : '' %>">
      <div class="edot-pimg">
        <% if (product.image) { %>
        <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" onerror="this.style.display='none'">
        <% } else { %>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;"><iconify-icon icon="mdi:gamepad-variant" style="font-size:28px;color:#b7c4e0;"></iconify-icon></div>
        <% } %>
        <span class="edot-tag <%= bad ? 'off' : '' %>"><iconify-icon icon="<%= bad ? 'mdi:close-circle' : 'mdi:flash' %>" style="font-size:10px;"></iconify-icon><%= tagTxt %></span>
      </div>
      <div class="edot-pname"><%= product.name %></div>
      <div class="edot-psub"><iconify-icon icon="mdi:cart-outline" style="font-size:11px;"></iconify-icon><%= soldLabel %> Terjual</div>
    </a>
    <% }); %>
  </div>

  <% if (products.length === 0) { %>
  <div style="text-align:center;padding:50px 0;color:#94a3b8;">
    <iconify-icon icon="mdi:package-variant" style="font-size:42px;display:block;margin-bottom:8px;"></iconify-icon>
    <p style="font-size:12px;font-weight:600;">Belum ada produk tersedia</p>
  </div>
  <% } %>

  <% if (typeof totalActiveProducts !== 'undefined' && totalActiveProducts > products.length) { %>
  <div style="text-align:center;margin-top:16px;">
    <a href="/produk" style="display:inline-flex;align-items:center;gap:6px;padding:11px 22px;border-radius:12px;font-size:12px;font-weight:800;color:#2563eb;background:#fff;border:1px solid #cfdcf8;text-decoration:none;box-shadow:var(--shadow-card);">
      Lihat Semua Produk (<%= totalActiveProducts %>) <iconify-icon icon="mdi:chevron-right" style="font-size:15px;"></iconify-icon>
    </a>
  </div>
  <% } %>
</div>

<% if (typeof user !== 'undefined' && user && !isAdmin) { %>
<div class="edot-wrap" style="margin-top:20px;">
  <a href="/arcade" style="display:block;border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-card);line-height:0;">
    <img src="/uploads/arcade-banner.jpg" alt="Arcade Center" style="width:100%;height:auto;display:block;aspect-ratio:2172/724;object-fit:cover;">
  </a>
</div>
<% } %>

<% if (user && user.is_reseller) { %>
<div class="edot-wrap" style="margin-top:16px;">
  <div style="border-radius:14px;padding:13px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fffbeb;border:1px solid #fde68a;">
    <div style="display:flex;align-items:center;gap:11px;">
      <div style="width:38px;height:38px;border-radius:11px;background:#fef3c7;display:flex;align-items:center;justify-content:center;"><iconify-icon icon="mdi:crown" style="color:#d97706;font-size:20px;"></iconify-icon></div>
      <div>
        <div style="font-size:12px;font-weight:800;color:#78350f;">Status Reseller VIP Aktif</div>
        <div style="font-size:10.5px;color:#92400e;margin-top:2px;">Diskon <strong><%= resellerSettings.discount %>%</strong> untuk semua pembelian</div>
      </div>
    </div>
    <a href="/reseller" style="flex-shrink:0;padding:8px 13px;border-radius:10px;font-size:11px;font-weight:800;color:#92400e;background:#fde68a;text-decoration:none;white-space:nowrap;">Lihat Panel</a>
  </div>
</div>
<% } %>

<!-- ══ KENAPA KAMI ══ -->
<div class="edot-wrap" style="margin-top:6px;">
  <div class="edot-sec-title"><h2>Kenapa <%= siteName %>?</h2></div>
  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:9px;">
    <% [['mdi:shield-check','#16a34a','#ecfdf3','100% Aman','Garansi akun aman'],['mdi:flash','#2563eb','#eef3ff','Proses Cepat','Instan 0-1 menit'],['mdi:headset','#7c3aed','#f3ecff','Support 24/7','Respon cepat'],['mdi:star-circle','#d97706','#fff7e6','Terpercaya','Ribuan pengguna']].forEach(f => { %>
    <div class="edot-box" style="display:flex;align-items:center;gap:10px;padding:12px;">
      <div style="width:38px;height:38px;border-radius:11px;background:<%= f[2] %>;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><iconify-icon icon="<%= f[0] %>" style="font-size:20px;color:<%= f[1] %>;"></iconify-icon></div>
      <div><div style="font-size:12px;font-weight:800;color:#0f172a;"><%= f[3] %></div><div style="font-size:10px;color:#94a3b8;margin-top:2px;font-weight:600;"><%= f[4] %></div></div>
    </div>
    <% }); %>
  </div>
</div>

<div style="height:18px;"></div>
<%- include('../partials/edot-footer') %>
<%- include('../partials/edot-bottom') %>

<!-- Notifikasi pembelian user lain -->
<div id="purchase-toast" style="position:fixed;bottom:78px;left:12px;z-index:39;max-width:270px;display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:14px;background:#fff;border:1px solid var(--border);box-shadow:0 10px 28px -10px rgba(15,23,42,.3);transform:translateY(140%);opacity:0;transition:transform .4s,opacity .4s;">
  <div id="pt-avatar" style="flex-shrink:0;width:34px;height:34px;border-radius:10px;background:#eef3ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;"></div>
  <div style="flex:1;min-width:0;">
    <div id="pt-text" style="font-size:11px;font-weight:600;color:#475569;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;"></div>
    <div id="pt-time" style="font-size:9.5px;color:#94a3b8;margin-top:3px;display:flex;align-items:center;gap:4px;"><iconify-icon icon="mdi:check-decagram" style="color:#16a34a;font-size:11px;"></iconify-icon><span></span></div>
  </div>
  <button type="button" onclick="hidePurchaseToast()" style="flex-shrink:0;width:20px;height:20px;border-radius:50%;background:#f1f5fb;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;"><iconify-icon icon="mdi:close" style="color:#94a3b8;font-size:12px;"></iconify-icon></button>
</div>

<% if (settings.contact?.whatsapp) { %>
<a href="https://wa.me/<%= String(settings.contact.whatsapp).replace(/\D/g,'') %>" target="_blank" rel="noopener" aria-label="WhatsApp"
   style="position:fixed;bottom:80px;right:14px;z-index:40;width:46px;height:46px;border-radius:50%;background:#22c55e;box-shadow:0 6px 18px rgba(34,197,94,.45);display:flex;align-items:center;justify-content:center;text-decoration:none;">
  <iconify-icon icon="mdi:whatsapp" style="color:#fff;font-size:24px;"></iconify-icon>
</a>
<% } %>

<style>
.c-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.55);cursor:pointer;flex-shrink:0;transition:all .35s;}
.c-dot.active{width:22px;border-radius:4px;background:#fff;box-shadow:0 1px 6px rgba(15,23,42,.3);}
#carousel-track>div{flex:0 0 100%;width:100%;height:100%;position:relative;overflow:hidden;}
@media(min-width:768px){#purchase-toast{bottom:20px!important;}}
</style>

<!-- ══ SCRIPTS ══ -->
<script>
/* Carousel */
(function(){
  let slides=[],cur=0,total=1,timer=null;
  const IV=4500;
  async function init(){
    try{const r=await fetch('/api/banners');slides=await r.json();}catch{slides=[];}
    const track=document.getElementById('carousel-track');
    const dots=document.getElementById('carousel-dots');
    if(!slides.length){total=1;return;}
    document.getElementById('c-slide-default')?.remove();
    track.innerHTML=slides.map((s,i)=>{
      const cl=s.link&&s.link!=='/';
      // FIX "banner kepotong": sebelumnya foreground <img> pakai
      // object-fit:cover di dalam box tinggi TETAP (#carousel-wrap,
      // clamp(180px,40vw,290px)) -- cover artinya gambar di-ZOOM & bagian
      // yang gak muat (atas/bawah atau kiri/kanan, tergantung rasio) di-CROP
      // biar penuhin box, jadi logo/teks di pinggir banner sering kepotong
      // kalau rasio gambar upload beda dari rasio box. Sekarang foreground
      // pakai object-fit:contain (gambar SELALU utuh, gak pernah dipotong),
      // dan biar gak ada bar kosong polos di sisi yang nggak kepenuhin,
      // dikasih background blur dari gambar yang sama (teknik kayak
      // Instagram Stories/YouTube) supaya tetap kelihatan penuh & rapi.
      return`<div style="flex:0 0 100%;position:relative;overflow:hidden;background:#09040f;"${cl?` onclick="window.location='${s.link}'" style="flex:0 0 100%;position:relative;overflow:hidden;cursor:pointer;background:#09040f;"`:''}>
        <img src="${s.imageUrl}" alt="" aria-hidden="true" loading="${i===0?'eager':'lazy'}"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(22px) brightness(.85);transform:scale(1.15);"
             onerror="this.style.display='none'">
        <img src="${s.imageUrl}" alt="${s.title||''}" loading="${i===0?'eager':'lazy'}"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:1;"
             onerror="this.style.display='none'">
        <div style="position:absolute;inset:0;background:linear-gradient(105deg,rgba(15,23,42,.55) 0%,rgba(15,23,42,.12) 55%,transparent 100%);z-index:2;"></div>
        <div style="position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,4vw,30px) clamp(18px,6vw,50px);max-width:65%;">
          ${s.title?`<div style="font-size:clamp(16px,4vw,38px);font-weight:900;color:#fff;line-height:1.1;text-shadow:0 2px 20px rgba(0,0,0,.8);">${s.title}</div>`:''}
          ${s.subtitle?`<div style="font-size:clamp(10px,1.8vw,14px);color:rgba(255,255,255,.7);margin-top:6px;">${s.subtitle}</div>`:''}
          ${cl?`<div style="display:inline-flex;align-items:center;gap:5px;margin-top:12px;padding:8px 18px;border-radius:10px;font-size:11px;font-weight:800;background:linear-gradient(135deg,#2563eb,#4f46e5);color:#fff;width:fit-content;"><iconify-icon icon="mdi:arrow-right" style="font-size:12px;"></iconify-icon> Lihat Detail</div>`:''}
        </div>
      </div>`;
    }).join('');
    total=slides.length;
    dots.innerHTML=slides.map((_,i)=>`<div class="c-dot${i===0?' active':''}" onclick="goSlide(${i})"></div>`).join('');
    if(total>1){startAuto();addSwipe();}
    goSlide(0);
  }
  window.goSlide=function(idx){if(total<=1)return;cur=((idx%total)+total)%total;document.getElementById('carousel-track').style.transform=`translateX(-${cur*100}%)`;document.querySelectorAll('.c-dot').forEach((d,i)=>d.classList.toggle('active',i===cur));};
  function startAuto(){clearInterval(timer);timer=setInterval(()=>goSlide(cur+1),IV);}
  function addSwipe(){const w=document.getElementById('carousel-wrap');w.addEventListener('touchstart',e=>{clearInterval(timer);w._tx=e.touches[0].clientX;},{passive:true});w.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-w._tx;if(Math.abs(dx)>38)goSlide(cur+(dx<0?1:-1));startAuto();},{passive:true});}
  document.addEventListener('DOMContentLoaded',init);
})();

/* Filter */
function filterProducts(cat){
  document.querySelectorAll('[data-category]').forEach(c=>{c.style.display=(cat==='all'||c.dataset.category===cat)?'':'none';});
  document.querySelectorAll('.fpill').forEach(b=>b.classList.toggle('active',b.dataset.pf===cat));
  const n=[...document.querySelectorAll('[data-category]')].filter(c=>c.style.display!=='none').length;
  const el=document.getElementById('shown-count'); if(el) el.textContent=n+' produk';
}

/* Notifikasi pembelian user lain */
(function(){
  const names=['Rizky','Andi','Dimas','Farhan','Wanda','Putra','Bintang','Kevin','Abil','Hergi','Rehan','Dwi','Yoga','Fajar','Indra','Naufal','Aldi','Salsa','Sinta','Reza'];
  const cities=['Jakarta','Bandung','Surabaya','Medan','Semarang','Makassar','Bekasi','Tangerang','Depok','Bogor','Yogyakarta','Palembang'];
  const toast=document.getElementById('purchase-toast');
  if(!toast)return;
  const textEl=document.getElementById('pt-text');
  const timeEl=toast.querySelector('#pt-time span');
  const avatarEl=document.getElementById('pt-avatar');
  let products=[];
  try{products=<%- JSON.stringify(popularProducts) %>;}catch(e){products=[];}
  let hideTimer=null, cycleTimer=null, dismissed=false;

  function pick(arr){return arr[Math.floor(Math.random()*arr.length)];}

  function showToast(){
    if(dismissed||!products.length)return;
    const p=pick(products);
    const name=pick(names);
    const city=pick(cities);
    const mins=Math.floor(Math.random()*28)+1;
    avatarEl.textContent=name.charAt(0).toUpperCase();
    textEl.innerHTML=`<strong style="color:#0f172a;">${name}</strong> dari ${city} baru saja membeli <strong style="color:#2563eb;">${p.name}</strong>`;
    timeEl.textContent=mins<=1?'Baru saja':`${mins} menit yang lalu`;
    toast.style.transform='translateY(0)';
    toast.style.opacity='1';
    clearTimeout(hideTimer);
    hideTimer=setTimeout(hidePurchaseToast,5000);
  }

  window.hidePurchaseToast=function(){
    toast.style.transform='translateY(140%)';
    toast.style.opacity='0';
  };

  function loop(){
    showToast();
    cycleTimer=setTimeout(loop,Math.floor(Math.random()*5000)+8000);
  }
  setTimeout(loop,4000);
})();

</script>
