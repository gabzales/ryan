<%
const pageTitle = 'Key Saya';
const lbl = 'display:block;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2);';
%>
<%- include('../partials/edot-header') %>
<div style="padding:16px 16px 40px;">
<div style="max-width:520px;margin:0 auto;">

  <div style="text-align:center;margin:8px 0 18px;">
    <div style="width:56px;height:56px;border-radius:16px;background:#eef3ff;border:1px solid #d6e2fd;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
      <iconify-icon icon="mdi:key-chain-variant" style="font-size:28px;color:#2563eb;"></iconify-icon>
    </div>
    <h1 style="font-size:20px;font-weight:900;color:var(--text-1);">Key Saya</h1>
    <p style="font-size:12px;color:var(--text-3);margin-top:4px;">Semua key yang pernah kamu beli ada di sini.</p>
  </div>

  <% if (!orders.length) { %>
  <div class="neon-card" style="padding:28px 18px;text-align:center;">
    <p style="font-size:13px;color:var(--text-2);">Belum ada key. Pembelian yang sudah selesai akan muncul di sini.</p>
    <a href="/produk" class="btn-primary" style="display:inline-block;margin-top:14px;padding:10px 18px;border-radius:10px;font-size:13px;text-decoration:none;">Lihat Produk</a>
  </div>
  <% } else { %>
  <input id="ksSearch" type="text" class="hm-input" placeholder="Cari produk atau kode pesanan..." oninput="ksFilter(this.value)" style="margin-bottom:12px;">
  <div id="ksList">
  <% orders.forEach(function(o){ %>
  <div class="neon-card ks-item" data-q="<%= (o.productName + ' ' + o.code + ' ' + o.duration).toLowerCase() %>" style="padding:14px;margin-bottom:10px;">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">
      <div style="min-width:0;">
        <div style="font-weight:800;font-size:14px;color:var(--text-1);"><%= o.productName %></div>
        <div style="font-size:11px;color:var(--text-3);margin-top:2px;"><%= o.duration %><%= o.keys.length > 1 ? ' · ' + o.keys.length + ' key' : '' %></div>
      </div>
      <div style="text-align:right;flex-shrink:0;font-size:10px;color:var(--text-3);">
        <div style="font-family:monospace;"><%= o.code %></div>
        <div><%= o.time || (o.at ? new Date(o.at).toLocaleDateString('id-ID') : '') %></div>
      </div>
    </div>
    <% if (o.partial) { %><div style="font-size:11px;color:#d97706;margin-top:6px;">Sebagian key. Sisanya diproses admin.</div><% } %>
    <% o.keys.forEach(function(k){ %>
    <div style="display:flex;align-items:center;gap:8px;margin-top:8px;padding:9px 10px;border-radius:10px;background:rgba(37,99,235,.06);border:1px solid rgba(37,99,235,.15);">
      <code style="flex:1;min-width:0;font-size:12px;word-break:break-all;color:var(--text-1);"><%= k %></code>
      <button type="button" onclick="ksCopy(this, this.getAttribute('data-k'))" data-k="<%= k %>" style="flex-shrink:0;padding:6px 10px;border-radius:8px;font-size:11px;font-weight:800;background:#2563eb;color:#fff;">Salin</button>
    </div>
    <% }) %>
    <% if (o.keys.length > 1) { %>
    <button type="button" onclick="ksCopy(this, this.getAttribute('data-all'))" data-all="<%= o.keys.join('\n') %>" style="margin-top:8px;width:100%;padding:8px;border-radius:10px;font-size:11px;font-weight:800;border:1px solid rgba(37,99,235,.3);color:#2563eb;background:transparent;">Salin semua key</button>
    <% } %>
    <a href="/invoice?code=<%= encodeURIComponent(o.code) %>" style="display:block;margin-top:8px;font-size:11px;color:var(--text-3);text-align:right;text-decoration:none;">Lihat invoice</a>
  </div>
  <% }) %>
  </div>
  <% } %>
</div></div>
<script>
function ksCopy(btn, text){
  var done = function(){ var t = btn.textContent; btn.textContent = 'Tersalin'; setTimeout(function(){ btn.textContent = t; }, 1200); };
  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fb); else fb();
  function fb(){ var a = document.createElement('textarea'); a.value = text; document.body.appendChild(a); a.select(); try { document.execCommand('copy'); } catch(e){} a.remove(); done(); }
}
function ksFilter(q){
  q = String(q||'').toLowerCase().trim();
  document.querySelectorAll('.ks-item').forEach(function(el){ el.style.display = (!q || el.getAttribute('data-q').indexOf(q) > -1) ? '' : 'none'; });
}
</script>
