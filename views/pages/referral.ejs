<%
const pageTitle = 'Ajak Teman';
const rp = (n) => 'Rp ' + Number(n || 0).toLocaleString('id-ID');
%>
<%- include('../partials/edot-header') %>
<div style="padding:16px 16px 40px;">
<div style="max-width:480px;margin:0 auto;">

  <div style="text-align:center;margin:8px 0 18px;">
    <div style="width:56px;height:56px;border-radius:16px;background:#fdf2f8;border:1px solid #fbcfe8;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
      <iconify-icon icon="mdi:account-multiple-plus" style="font-size:28px;color:#db2777;"></iconify-icon>
    </div>
    <h1 style="font-size:20px;font-weight:900;color:var(--text-1);">Ajak Teman</h1>
    <% if (cfg.enabled) { %>
    <p style="font-size:12px;color:var(--text-3);margin-top:4px;">Dapat <strong><%= rp(cfg.bonus) %></strong> saldo untuk tiap teman yang daftar lewat link kamu dan beli pertama kali<%= cfg.minPurchase ? ' (min. ' + rp(cfg.minPurchase) + ')' : '' %>.</p>
    <% } else { %>
    <p style="font-size:12px;color:var(--text-3);margin-top:4px;">Program ajak teman sedang tidak aktif.</p>
    <% } %>
  </div>

  <div class="neon-card" style="padding:18px;">
    <div style="font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2);margin-bottom:8px;">Kode kamu</div>
    <div style="font-family:monospace;font-size:26px;font-weight:900;letter-spacing:.15em;text-align:center;color:var(--text-1);padding:10px 0;"><%= code %></div>
    <input id="rfLink" type="text" readonly class="hm-input" value="<%= link %>" style="font-size:12px;margin-bottom:10px;" onclick="this.select()">
    <div style="display:flex;gap:8px;">
      <button type="button" class="btn-primary" style="flex:1;padding:12px;border-radius:10px;font-size:13px;" onclick="rfCopy()">Salin Link</button>
      <a class="btn-primary" style="flex:1;padding:12px;border-radius:10px;font-size:13px;text-align:center;text-decoration:none;background:#16a34a;" target="_blank" rel="noopener"
         href="https://wa.me/?text=<%= encodeURIComponent('Beli key murah & instan di ' + (settings.siteName || 'toko ini') + ': ' + link) %>">Bagikan WA</a>
    </div>
  </div>

  <div style="display:flex;gap:10px;margin-top:14px;">
    <div class="neon-card" style="flex:1;padding:14px;text-align:center;"><div style="font-size:22px;font-weight:900;color:var(--text-1);"><%= invitedCount %></div><div style="font-size:11px;color:var(--text-3);">Teman daftar</div></div>
    <div class="neon-card" style="flex:1;padding:14px;text-align:center;"><div style="font-size:22px;font-weight:900;color:#16a34a;"><%= rp(earned) %></div><div style="font-size:11px;color:var(--text-3);">Total bonus</div></div>
  </div>

  <% if (invited.length) { %>
  <div class="neon-card" style="padding:16px;margin-top:14px;">
    <div style="font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2);margin-bottom:8px;">Teman yang kamu ajak</div>
    <% invited.forEach(function(u){ %>
    <div style="display:flex;justify-content:space-between;padding:8px 0;border-top:1px solid var(--border);font-size:12px;">
      <span style="color:var(--text-1);font-weight:700;"><%= u.name %></span>
      <span style="font-weight:800;color:<%= u.rewarded ? '#16a34a' : '#d97706' %>;"><%= u.rewarded ? 'Bonus cair' : 'Belum beli' %></span>
    </div>
    <% }) %>
  </div>
  <% } %>
</div></div>
<script>
function rfCopy(){
  var el = document.getElementById('rfLink'); el.select();
  var ok = function(){ var b = event && event.target; if (b) { var t = b.textContent; b.textContent = 'Tersalin'; setTimeout(function(){ b.textContent = t; }, 1200); } };
  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(el.value).then(ok, function(){ document.execCommand('copy'); ok(); });
  else { try { document.execCommand('copy'); } catch(e){} ok(); }
}
</script>
