<%
const __sn = String((typeof settings !== 'undefined' && settings && settings.siteName) || 'RyanStore').trim();
const __sp = __sn.split(/\s+/);
const __b1 = __sp[0] || 'RYAN';
const __b2 = __sp.slice(1).join(' ');
%>
<a href="/" class="edot-brand">
  <span class="edot-logo"><img src="/uploads/logo-ryanstore-icon.png" alt="<%= __sn %>" width="34" height="34"></span>
  <span class="edot-brand-txt"><b><%= __b1.toUpperCase() %></b><% if (__b2) { %><i><%= __b2.toUpperCase() %></i><% } %></span>
</a>
