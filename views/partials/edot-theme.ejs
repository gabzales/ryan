<style id="edot-theme">
/* ═══════════════════════════════════════════════════════════
   RYAN NEW ERA — tema terang (gaya toko game modern)
   Hanya aktif di halaman publik (html.edot). Panel /admin tetap gelap.
   Variabel lama (--blue, --bg-card, dst) di-override di sini supaya semua
   halaman yang pakai var(--...) otomatis ikut terang.
   ═══════════════════════════════════════════════════════════ */
html.edot{
  --bg-main:#f3f5fa; --bg-section:#ffffff; --bg-card:#ffffff; --bg-hover:#f1f5fb;
  --border:#e6eaf3; --border-md:#d5dcea;
  --blue:#2563eb; --blue-dim:rgba(37,99,235,.10); --blue-dark:#1d4ed8;
  --green:#16a34a; --green-dim:rgba(22,163,74,.10);
  --red:#dc2626; --red-dim:rgba(220,38,38,.09); --amber:#d97706;
  --text-1:#0f172a; --text-2:#475569; --text-3:#94a3b8;
  --neon-purple:#2563eb; --neon-violet:#4f46e5; --accent-color:#2563eb;
  --bg-dark:#f3f5fa; --glow-color:rgba(37,99,235,.08);
  --shadow-card:0 1px 2px rgba(15,23,42,.04),0 4px 14px -6px rgba(15,23,42,.08);
  background:#f3f5fa; color-scheme:light;
}
html.edot body{background:var(--bg-main);color:var(--text-1);}
html.edot ::-webkit-scrollbar-track{background:#eef1f7;}
html.edot ::-webkit-scrollbar-thumb{background:#c4cde0;}
html.edot body::before,html.edot body::after{display:none;}

/* ── komponen bawaan ── */
html.edot .card,html.edot .glass,html.edot .glass-strong,html.edot .neon-card,html.edot .testi-card{box-shadow:var(--shadow-card);}
html.edot .btn-ghost{background:#f1f5fb;border-color:var(--border);color:var(--text-2);}
html.edot .btn-ghost:hover{background:#e8eef9;}
html.edot .btn-outline:hover{color:var(--blue);}
html.edot .hm-input,html.edot .form-input{background:#fff;border-color:var(--border-md);color:var(--text-1);}
html.edot .hm-input:focus,html.edot .form-input:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.12);}
html.edot .status-pending{background:#fef3c7;color:#b45309;border-color:#fde68a;}
html.edot .status-done{background:#dcfce7;color:#15803d;border-color:#bbf7d0;}
html.edot .status-cancelled{background:#fee2e2;color:#b91c1c;border-color:#fecaca;}
html.edot .modal-overlay{background:rgba(15,23,42,.5);}
html.edot .modal-sheet::-webkit-scrollbar-thumb{background:#c4cde0;}
html.edot .toast,html.edot .purchase-notif{background:#fff;box-shadow:0 8px 24px -8px rgba(15,23,42,.25);}
html.edot .shimmer-text,html.edot .neon-text{text-shadow:none;}
html.edot .platform-label{background:var(--blue-dim)!important;color:var(--blue)!important;}
html.edot #search-panel,html.edot #menu-drawer-content{color:var(--text-1);}
html.edot .side-drawer{box-shadow:-10px 0 30px -12px rgba(15,23,42,.25);}

/* ── override utilitas Tailwind yang di-hardcode untuk tema gelap ── */
html.edot .text-white{color:var(--text-1);}
html.edot .text-slate-200,html.edot .text-slate-300,html.edot .text-gray-200,html.edot .text-gray-300{color:var(--text-1);}
html.edot .text-slate-400,html.edot .text-gray-400{color:var(--text-2);}
html.edot .text-slate-500,html.edot .text-slate-600,html.edot .text-gray-500,html.edot .text-gray-600{color:var(--text-3);}
html.edot .text-purple-300,html.edot .text-purple-400,html.edot .text-violet-300,html.edot .text-violet-400,html.edot .text-indigo-300,html.edot .text-indigo-400,html.edot .text-blue-300,html.edot .text-blue-400{color:var(--blue);}
html.edot .text-green-400,html.edot .text-emerald-400{color:#15803d;}
html.edot .text-red-400{color:#dc2626;}
html.edot .text-yellow-400,html.edot .text-amber-400{color:#b45309;}
html.edot [class*="text-white/"]{color:var(--text-3);}
html.edot .text-white\/60,html.edot .text-white\/70,html.edot .text-white\/50{color:var(--text-2);}
html.edot .text-white[class*="bg-gradient"],html.edot .text-white[class*="bg-blue"]{color:#fff!important;}
html.edot .keep-white{color:#fff!important;}
html.edot [class*="bg-white/"]{background-color:rgba(15,23,42,.04)!important;}
html.edot [class*="bg-black/"]{background-color:rgba(15,23,42,.05)!important;}
html.edot [class*="border-white/"]{border-color:var(--border)!important;}
html.edot [class*="bg-[#0"],html.edot [class*="bg-[#1"]{background-color:#fff!important;}
html.edot [class*="border-purple-"],html.edot [class*="border-indigo-"],html.edot [class*="border-violet-"]{border-color:var(--border-md)!important;}
html.edot [class*="bg-purple-"],html.edot [class*="bg-violet-"],html.edot [class*="bg-indigo-"]{background-color:var(--blue-dim)!important;}
html.edot [class*="bg-green-"],html.edot [class*="bg-emerald-"]{background-color:var(--green-dim)!important;}
html.edot [class*="bg-red-"]{background-color:var(--red-dim)!important;}
html.edot [class*="bg-yellow-"],html.edot [class*="bg-amber-"]{background-color:rgba(217,119,6,.10)!important;}
html.edot [class*="divide-white"]>*+*{border-color:var(--border)!important;}
html.edot .bg-clip-text,html.edot [class*="text-transparent"]{color:transparent;}

/* ── override style inline gelap (halaman lama: buy, dashboard, arcade, dst) ── */
html.edot [style*="background:rgba(255,255,255,.0"],html.edot [style*="background: rgba(255,255,255,.0"],html.edot [style*="background:rgba(255,255,255,0."]{background:rgba(15,23,42,.04)!important;}
html.edot [style*="border:1px solid rgba(255,255,255"],html.edot [style*="border-color:rgba(255,255,255"]{border-color:var(--border)!important;}
html.edot [style*="border:1px solid rgba(124,"],html.edot [style*="border:1px solid rgba(124 "],html.edot [style*="border-bottom:1px solid rgba(124,"],html.edot [style*="border-top:1px solid rgba(124,"]{border-color:var(--border)!important;}
html.edot [style*="background:#09040f"],html.edot [style*="background:#110a1a"],html.edot [style*="background:#170c22"],html.edot [style*="background:#160b21"],html.edot [style*="background:#1d0f2b"],html.edot [style*="background:#0c0714"],html.edot [style*="background:#0d0d20"],html.edot [style*="background:#0a0f1e"],html.edot [style*="background:#0f1629"],html.edot [style*="background:#111827"]{background:#fff!important;}
html.edot [style*="background:rgba(124,47,214,.0"],html.edot [style*="background:rgba(124,47,214,.1"],html.edot [style*="background:rgba(124,58,220,.0"],html.edot [style*="background:rgba(124,58,220,.1"]{background:var(--blue-dim)!important;}
html.edot [style*="color:#c084fc"],html.edot [style*="color:#d8b4fe"],html.edot [style*="color:#a78bfa"],html.edot [style*="color:#7c2fd6"],html.edot [style*="color:#818cf8"]{color:var(--blue)!important;}
html.edot [style*="color:rgba(148,163,184"],html.edot [style*="color:#94a3b8"]{color:var(--text-2)!important;}
html.edot [style*="color:#e2e8f0"],html.edot [style*="color:#f3ecff"],html.edot [style*="color:#f1f5f9"]{color:var(--text-1)!important;}
html.edot [style*="color:#4ade80"]{color:#15803d!important;}
html.edot [style*="color:#f87171"]{color:#dc2626!important;}
html.edot [style*="color:#fbbf24"]{color:#b45309!important;}
html.edot [style*="background:#7c2fd6"],html.edot [style*="background:var(--blue)"]{background:var(--blue)!important;}
html.edot [style*="linear-gradient(135deg,#57169e"],html.edot [style*="linear-gradient(135deg,#7c2fd6"],html.edot [style*="linear-gradient(135deg,#7c3aed"]{background:linear-gradient(135deg,#2563eb,#1d4ed8)!important;}
/* teks putih di atas tombol/elemen berwarna tetap putih */
html.edot .btn-primary,html.edot .btn-green,html.edot .btn-red,html.edot .btn-gaming,html.edot .filter-pill.active,html.edot .cat-btn.active,
html.edot .btn-primary *,html.edot .btn-green *,html.edot .btn-red *,html.edot .btn-gaming *,
html.edot [class*="bg-blue-"] .text-white,html.edot [class*="bg-gradient"] .text-white,html.edot button[class*="bg-"] .text-white,
html.edot .keep-white,html.edot .keep-white *{color:#fff!important;}
html.edot .btn-primary,html.edot .btn-gaming{background:var(--blue);}
html.edot a.text-white[class*="bg-"],html.edot button.text-white[class*="bg-"]{color:#fff;}

html.edot [class*="text-zinc-"]{color:var(--text-2);}
html.edot .text-zinc-500,html.edot .text-zinc-600{color:var(--text-3);}
html.edot .hover\:text-zinc-300:hover,html.edot .hover\:text-zinc-400:hover,html.edot .hover\:text-purple-300:hover{color:var(--blue);}
html.edot [class*="bg-zinc-"],html.edot [class*="bg-slate-"],html.edot [class*="bg-gray-"]{background-color:#fff!important;}
html.edot [class*="border-zinc-"],html.edot [class*="border-slate-"],html.edot [class*="border-gray-"]{border-color:var(--border)!important;}
html.edot .auth-brand{display:flex;justify-content:center;margin-bottom:10px;}
/* ═══════ header ═══════ */
.edot-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--border);box-shadow:0 1px 8px -4px rgba(15,23,42,.12);}
.edot-header-in{max-width:1100px;margin:0 auto;padding:0 14px;height:58px;display:flex;align-items:center;gap:10px;}
.edot-brand{display:flex;align-items:center;gap:9px;text-decoration:none;min-width:0;flex-shrink:0;}
.edot-logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#2563eb,#4f46e5);color:#fff;font-weight:900;font-size:17px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 10px -3px rgba(37,99,235,.55);flex-shrink:0;letter-spacing:-.02em;}
.edot-brand-txt{display:flex;flex-direction:column;line-height:1;}
.edot-brand-txt b{font-size:16px;font-weight:900;color:#0f172a;letter-spacing:.02em;}
.edot-brand-txt i{font-style:normal;font-size:8.5px;font-weight:800;letter-spacing:.32em;color:#2563eb;margin-top:3px;}
.edot-hbtn{width:36px;height:36px;border-radius:10px;background:#f1f5fb;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#475569;text-decoration:none;flex-shrink:0;}
.edot-hbtn:hover{background:#e8eef9;}
.edot-login{padding:0 14px;height:36px;border-radius:10px;background:#2563eb;color:#fff!important;font-size:12px;font-weight:800;display:inline-flex;align-items:center;gap:5px;text-decoration:none;white-space:nowrap;}
.edot-hnav{display:none;align-items:center;gap:4px;margin-left:18px;}
.edot-hnav a{padding:8px 12px;border-radius:9px;font-size:13px;font-weight:700;color:#475569;text-decoration:none;}
.edot-hnav a:hover,.edot-hnav a.on{background:#eef3ff;color:#2563eb;}
@media(min-width:768px){.edot-hnav{display:flex;}}

/* ═══════ bottom nav (mobile) ═══════ */
.edot-bnav{position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;border-top:1px solid var(--border);box-shadow:0 -4px 16px -8px rgba(15,23,42,.16);display:flex;padding:6px 6px calc(6px + env(safe-area-inset-bottom));}
.edot-bnav a{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:5px 0;border-radius:10px;color:#94a3b8;text-decoration:none;font-size:10px;font-weight:700;}
.edot-bnav a iconify-icon{font-size:22px;}
.edot-bnav a.on{color:#2563eb;}
.edot-bnav a.on iconify-icon{filter:drop-shadow(0 2px 4px rgba(37,99,235,.35));}
@media(min-width:768px){.edot-bnav{display:none;}}
.edot-pad-b{padding-bottom:84px;}
@media(min-width:768px){.edot-pad-b{padding-bottom:24px;}}

/* ═══════ footer ═══════ */
.edot-footer{background:#fff;border-top:1px solid var(--border);padding:28px 16px 100px;margin-top:8px;}
@media(min-width:768px){.edot-footer{padding-bottom:28px;}}
.edot-footer-in{max-width:1100px;margin:0 auto;}
.edot-footer h4{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#0f172a;margin-bottom:10px;}
.edot-footer a.fl{display:block;font-size:12px;font-weight:600;color:#64748b;text-decoration:none;padding:4px 0;}
.edot-footer a.fl:hover{color:#2563eb;}
.edot-soc{width:34px;height:34px;border-radius:10px;background:#f1f5fb;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:#475569;text-decoration:none;}

/* ═══════ umum ═══════ */
.edot-wrap{max-width:1100px;margin:0 auto;padding:0 14px;}
.edot-sec-title{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:20px 0 10px;}
.edot-sec-title h2{font-size:15px;font-weight:900;color:#0f172a;margin:0;letter-spacing:.01em;}
.edot-sec-title span{font-size:11px;font-weight:700;color:#94a3b8;}
.edot-chip{flex-shrink:0;padding:8px 16px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid var(--border-md);cursor:pointer;white-space:nowrap;background:#fff;color:#475569;transition:all .15s;}
.edot-chip.active{background:#2563eb;border-color:#2563eb;color:#fff;box-shadow:0 4px 10px -4px rgba(37,99,235,.6);}
.edot-quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
.edot-quick a{display:flex;flex-direction:column;align-items:center;gap:7px;padding:12px 4px;border-radius:14px;background:#fff;border:1px solid var(--border);box-shadow:var(--shadow-card);text-decoration:none;color:#0f172a;font-size:10.5px;font-weight:800;text-align:center;line-height:1.15;}
.edot-quick a i{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;font-style:normal;}
.edot-pcard{background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;box-shadow:var(--shadow-card);cursor:pointer;transition:transform .18s,box-shadow .2s,border-color .2s;padding:6px 6px 9px;display:block;text-decoration:none;}
.edot-pcard:hover{transform:translateY(-3px);border-color:#bcd0fb;box-shadow:0 12px 24px -12px rgba(37,99,235,.35);}
.edot-pcard:active{transform:scale(.97);}
.edot-pimg{position:relative;aspect-ratio:1/1;border-radius:10px;overflow:hidden;background:#eef2fa;}
.edot-pimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s;}
.edot-pcard:hover .edot-pimg img{transform:scale(1.05);}
.edot-tag{position:absolute;left:5px;bottom:5px;display:inline-flex;align-items:center;gap:2px;font-size:8.5px;font-weight:800;padding:2px 6px;border-radius:999px;background:rgba(255,255,255,.95);color:#2563eb;box-shadow:0 2px 6px rgba(15,23,42,.18);}
.edot-tag.off{color:#dc2626;}
.edot-pname{margin-top:7px;font-weight:800;font-size:11.5px;color:#0f172a;line-height:1.25;min-height:29px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;padding:0 2px;}
.edot-psub{margin-top:3px;display:flex;align-items:center;gap:3px;font-size:9.5px;color:#94a3b8;font-weight:600;padding:0 2px;}
.edot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;}
@media(min-width:640px){.edot-grid{grid-template-columns:repeat(4,1fr);gap:12px;}}
@media(min-width:900px){.edot-grid{grid-template-columns:repeat(5,1fr);}}
@media(min-width:1100px){.edot-grid{grid-template-columns:repeat(6,1fr);}}
.edot-input{width:100%;padding:12px 14px 12px 40px;border-radius:12px;background:#fff;border:1px solid var(--border-md);font-size:13px;color:#0f172a;font-family:inherit;}
.edot-input:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.12);}
.edot-box{background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-card);}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
@keyframes marqueeAnim{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>
